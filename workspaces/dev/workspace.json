{
  "description": "A development environment for your code!",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "logo.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Browser"
  ],
  "friendly_name": "Dev Workspace",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "0.0.0",
      "image": "eons/dev.workspace:latest",
      "uncompressed_size_mb": 1500,
      "available_tags": [
        "develop"
      ]
    }
  ]
}